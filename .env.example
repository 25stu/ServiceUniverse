FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=8000
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_PUBLIC_URL=http://localhost:8080
FRONTEND_ORIGINS=http://localhost:8000

# These localhost URLs are for running processes directly on the host.
# compose.yaml overrides them with Docker service names.
WATER_SERVICE_URL=http://localhost:8101
GAS_SERVICE_URL=http://localhost:8102
ATTRACTION_SERVICE_URL=http://localhost:8201
ATTRACTION_DATABASE_URL=sqlite:///services/attraction_reservation/data/attraction_reservation.db
LIBRARY_SERVICE_URL=http://localhost:8202
PARKING_AVAILABILITY_SERVICE_URL=http://localhost:8301
PARKING_BILLING_SERVICE_URL=http://localhost:8302
PARKING_AVAILABILITY_DATABASE_URL=sqlite:///services/parking_availability/data/parking_availability.db
PARKING_BILLING_DATABASE_URL=sqlite:///services/parking_billing/data/parking_billing.db

DOWNSTREAM_TIMEOUT_SECONDS=5
APP_ENV=development
LOG_LEVEL=INFO
